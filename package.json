{
  "name": "jetty",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "perf"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p client && tsc --noEmit -p perf",
    "test": "bun test",
    "dev:server": "bun run --watch server/src/main.ts",
    "dev:client": "bun run --filter @jetty/client dev",
    "build": "bun run --filter @jetty/client build",
    "start": "bun run server/src/main.ts",
    "perf": "bun perf/cli.ts",
    "sandbox": "bun perf/sandbox.ts",
    "paper:capture": "bun perf/paper/capture.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "patchedDependencies": {
    "@effect/platform-bun@4.0.0": "patches/@effect%2Fplatform-bun@4.0.0.patch",
    "@pierre/diffs@1.4.3": "patches/@pierre%2Fdiffs@1.4.3.patch"
  }
}
